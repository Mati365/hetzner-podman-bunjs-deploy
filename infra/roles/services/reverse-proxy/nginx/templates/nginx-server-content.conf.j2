keepalive_timeout 65;
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_buffers 16 8k;
gzip_http_version 1.1;
gzip_min_length 256;
gzip_types
  application/atom+xml
  application/geo+json
  application/javascript
  application/x-javascript
  application/json
  application/ld+json
  application/manifest+json
  application/rdf+xml
  application/rss+xml
  application/xhtml+xml
  application/xml
  font/eot
  font/otf
  font/ttf
  image/svg+xml
  text/css
  text/javascript
  text/plain
  text/xml;

location /assets/ {
  include includes/nginx-assets-proxy.conf;
  proxy_pass http://0.0.0.0:3004;
  proxy_redirect off;
}

location / {
  proxy_pass http://0.0.0.0:3004;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header Host      $http_host;
  proxy_redirect off;
}
